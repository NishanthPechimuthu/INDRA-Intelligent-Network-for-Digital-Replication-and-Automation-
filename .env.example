# Host port exposed by docker compose. The container always listens on 8080.
INDRA_PORT=8080

# ---------------------------------------------------------------------------
# INDRA platform foundation (Module 01)
# ---------------------------------------------------------------------------
# Supabase is optional at build time. With no values below, the platform runs on
# a local demo identity provider and seeded dataset, so the existing static
# deployment keeps working. With values present, every platform screen reads and
# writes through Supabase Auth/PostgREST with Row Level Security enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public origin used for auth redirects. Defaults to the browser origin.
VITE_SITE_URL=

# OAuth providers. Buttons render either way; set these to false to hide a
# provider that is not configured in the Supabase dashboard.
VITE_AUTH_GOOGLE_ENABLED=true
VITE_AUTH_MICROSOFT_ENABLED=true

# Reserved for later modules. Not read by Module 01 code; listed so the
# deployment shape is explicit before semantic search and AI features land.
# QDRANT_URL=
# QDRANT_API_KEY=
# LLM_API_URL=
# LLM_API_KEY=

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets (server-side only, never VITE_*)
# ---------------------------------------------------------------------------
# Set with: supabase secrets set PLATFORM_URL=https://your-app.example
# PLATFORM_URL=
# SITE_URL=
